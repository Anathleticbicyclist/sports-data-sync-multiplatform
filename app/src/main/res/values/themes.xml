<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JichiOB" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <!-- Toolbar 标题样式（居中、加粗、浅色融入页面） -->
    <style name="TextAppearance.JichiOB.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
