<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bc_bg"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_btnBack"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="历史记录"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_btnResume"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恢复"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/bc_text_secondary"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已导出的 FIT/GPX 文件与未完成记录"
        android:paddingStart="10dp"/>
    <ListView
        android:id="@+id/bc_listHistory"
        android:background="@drawable/bc_bg_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@color/bc_divider"
        android:dividerHeight="1dp"
        android:layout_weight="1"/>
</LinearLayout>
