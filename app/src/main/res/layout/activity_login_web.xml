<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIcon="@drawable/ic_back"
        app:titleTextColor="@color/white" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="登录完成后点击右侧按钮确认"
            android:textSize="11sp"
            android:textColor="#999999"
            android:gravity="center" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmLogin"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✅ 确认已登录"
            android:textSize="12sp"
            app:backgroundTint="@color/green"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 国际版mobile SSO登录界面（v6.7.8，默认隐藏） -->
    <LinearLayout
        android:id="@+id/mobileLoginLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvMobileLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="佳明国际版登录"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用mobile SSO方式（不经过Cloudflare）"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginBottom="32dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="邮箱"
            app:boxBackgroundMode="outline">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:autofillHints="email" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="密码"
            android:layout_marginTop="16dp"
            app:boxBackgroundMode="outline"
            app:passwordToggleEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:autofillHints="password" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMobileLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="登录"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:cornerRadius="12dp" />
        <TextView
            android:id="@+id/tvMobileLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginTop="16dp"
            android:gravity="center" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 登录失败常见原因"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 邮箱或密码错误（注意区分大小写）\n2. 开启了两步验证(MFA)，需先关闭\n3. 触发人机验证，改用软件内浏览器登录"
            android:textSize="12sp"
            android:textColor="#666666"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【关闭两步验证步骤】"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① 打开佳明Connect App或访问佳明官网登录\n② 进入「设置」→「账户」→「安全设置」\n③ 找到「两步验证」选项，点击关闭\n④ 确认关闭后，返回本App重新登录"
            android:textSize="11sp"
            android:textColor="#888888"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/tvMfaGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="→ 前往佳明账号安全设置（手动关闭）"
            android:textSize="12sp"
            android:textColor="#1989FA"
            android:autoLink="none"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp" />
        <TextView
            android:id="@+id/tvFallbackLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="→ 遇到人机验证？用软件内浏览器登录"
            android:textSize="12sp"
            android:textColor="#FF6B00"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
