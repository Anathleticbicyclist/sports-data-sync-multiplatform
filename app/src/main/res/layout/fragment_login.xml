<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- v7.7.7: 顶部品牌横幅 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_login_banner"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鸡翅幸哲迈进OB"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="让运动数据自由流动"
                android:textColor="#E6FFFFFF"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="选择平台登录，即可跨平台同步骑行数据"
                android:textColor="#BFFFFFFF"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- v8.2.2: 一键检测卡 v8.2.6: 再紧凑化（padding 6dp、标题12sp、按钮26dp、说明9sp、开关0.7） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#E3EEFA"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingTop="6dp" android:paddingEnd="8dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="一键登录检测" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckAll"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:insetTop="0dp" android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:text="检测" android:textSize="11sp"
                        app:backgroundTint="@color/primary" app:cornerRadius="10dp" />
                </LinearLayout>
                <TextView android:id="@+id/tvCheckStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="检测全部已登录平台的登录态（网络请求，约几秒）" android:textSize="9sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/tvCheckSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/green" android:visibility="gone" />
                <!-- v8.2.3: 会话内自动检查开关（默认开；开启后进入App约5s后台串行校验一次，不弹窗） -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="自动检查登录态（会话内一次，后台静默）" android:textSize="9sp" android:textColor="@color/text_secondary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" android:scaleX="0.7" android:scaleY="0.7" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- v8.2.2: 已登录平台分组标题 -->
        <TextView
            android:id="@+id/tvGroupLogged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:paddingStart="4dp"
            android:text="已登录平台"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- v8.2.2: 已登录平台卡片容器（程序化构建，每行2个） -->
        <LinearLayout
            android:id="@+id/containerLogged"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- v8.2.2: 未登录折叠条 v8.2.3.1: 明显胶囊按钮样式，新用户一眼可点 -->
        <LinearLayout
            android:id="@+id/llFoldToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_check_update"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:id="@+id/tvFoldToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未登录平台"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
            <TextView
                android:id="@+id/tvFoldArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▾ 点击展开"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- v8.2.2: 未登录平台卡片容器（程序化构建，默认折叠隐藏） -->
        <LinearLayout
            android:id="@+id/containerLoggedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
