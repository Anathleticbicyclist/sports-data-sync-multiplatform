<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:columnCount="2">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/igp_green" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="iGPSPORT" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvIgpStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnIgpLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录iGPSPORT" android:textSize="11sp" app:backgroundTint="@color/igp_green" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/xingzhe_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="行者" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvXingzheStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnXingzheLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录行者" android:textSize="11sp" app:backgroundTint="@color/xingzhe_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/magene_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="迈金" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvMageneStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnMageneLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录迈金" android:textSize="11sp" app:backgroundTint="@color/magene_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="#2c3e50" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="黑鸟" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvBlackbirdStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBlackbirdLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录黑鸟" android:textSize="11sp" app:backgroundTint="#2c3e50" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="百锐腾" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvBrytonStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBrytonLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录百锐腾" android:textSize="11sp" app:backgroundTint="@color/red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/wahoo_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Wahoo" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvWahooStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnWahooLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录Wahoo" android:textSize="11sp" app:backgroundTint="@color/wahoo_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/garmin_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="佳明国际" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvGarminComStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnGarminComLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录佳明国际" android:textSize="11sp" app:backgroundTint="@color/garmin_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/garmin_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="佳明中国" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvGarminCnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnGarminCnLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录佳明中国" android:textSize="11sp" app:backgroundTint="@color/garmin_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/coros_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="高驰中国" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvCorosCnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCorosCnLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录高驰中国" android:textSize="11sp" app:backgroundTint="@color/coros_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/coros_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="高驰国际" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvCorosIntStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCorosIntLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录高驰国际" android:textSize="11sp" app:backgroundTint="@color/coros_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Outbase（独占一行） -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/outbase_orange" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Outbase" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvOutbaseStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnOutbaseLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录Outbase" android:textSize="11sp" app:backgroundTint="@color/outbase_orange" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
        </GridLayout>

    </LinearLayout>
</ScrollView>
