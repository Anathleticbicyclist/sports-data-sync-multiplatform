<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bc_bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/bc_text_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="临时码表"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/bc_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="手机即码表 · 记录每一次运动"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/bc_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="10dp"
        android:text="选择运动类型"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:gravity="center"
            android:id="@+id/bc_cardCycling"
            android:background="@drawable/bc_bg_sport_normal"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="骑行"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:gravity="center"
            android:id="@+id/bc_cardRunning"
            android:background="@drawable/bc_bg_sport_normal"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="跑步"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:gravity="center"
            android:id="@+id/bc_cardWalking"
            android:background="@drawable/bc_bg_sport_normal"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="徒步"
            android:layout_weight="1"/>
    </LinearLayout>
    <Button
        android:textSize="18sp"
        android:textColor="@color/bc_white"
        android:id="@+id/bc_btnGo"
        android:background="@drawable/bc_bg_primary_button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="开始记录"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_btnSensors"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传感器"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_btnDisplay"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示设置"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_btnHistory"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="历史记录"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/bc_text_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="支持：GPS 1Hz 轨迹 · 气压计海拔 · BLE 心率/功率/踏频/速度 · 后台持续记录\10导出：FIT + GPX，可分享至其他平台导入"
        android:lineSpacingExtra="4dp"/>
</LinearLayout>
