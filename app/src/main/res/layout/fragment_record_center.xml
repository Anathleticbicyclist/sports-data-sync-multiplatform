<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- v8.2.0 记录中心：跨平台日期检索 + 本地记录管理 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnRecordClose"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="← 返回"
                android:textColor="@color/primary" android:textSize="14sp"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📚 记录中心"
                android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />

            <View android:layout_width="48dp" android:layout_height="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordStat"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="暂无缓存记录，先去同步一次"
            android:textColor="@color/text_secondary" android:textSize="11sp" />

        <!-- 日期快捷筛选 -->
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:scrollbars="none">
            <LinearLayout
                android:id="@+id/dateChips"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 平台筛选 -->
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:scrollbars="none">
            <LinearLayout
                android:id="@+id/platformChips"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22000000" android:layout_marginTop="4dp" />

    <!-- 记录列表（按日期分组） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecords"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="📭 该筛选条件下暂无记录\n（同步后记录会缓存在本地，支持按日期检索）"
        android:textColor="@color/text_secondary" android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
