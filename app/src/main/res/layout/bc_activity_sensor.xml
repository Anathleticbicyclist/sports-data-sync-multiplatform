<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bc_bg"
    android:padding="12dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_btnBack"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="传感器"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_btnScan"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重新扫描"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/bc_text_secondary"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已绑定设备（每类可绑定一个）"
        android:paddingStart="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowHeart"
        android:background="@drawable/bc_bg_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvHeartType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="心率计"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvHeartDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="未绑定"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvHeartState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_danger"
            android:id="@+id/bc_btnHeartUnbind"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowPower"
        android:background="@drawable/bc_bg_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvPowerType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="功率计"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvPowerDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="未绑定"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvPowerState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_danger"
            android:id="@+id/bc_btnPowerUnbind"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowCadence"
        android:background="@drawable/bc_bg_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvCadType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="踏频计"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvCadDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="未绑定"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvCadState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_danger"
            android:id="@+id/bc_btnCadUnbind"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowSpeed"
        android:background="@drawable/bc_bg_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvSpeedType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="速度计"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvSpeedDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="未绑定"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvSpeedState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_danger"
            android:id="@+id/bc_btnSpeedUnbind"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowCadRun"
        android:background="@drawable/bc_bg_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvCadRunType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="步频计"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvCadRunDev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="未绑定"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvCadRunState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_danger"
            android:id="@+id/bc_btnCadRunUnbind"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="忘记"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/bc_text_secondary"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫描结果（点击连接并绑定）"
        android:paddingStart="10dp"/>
    <ListView
        android:id="@+id/bc_listScanned"
        android:background="@drawable/bc_bg_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@color/bc_divider"
        android:dividerHeight="1dp"
        android:layout_weight="1"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/bc_text_secondary"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提示：连接前请开启蓝牙并让设备进入配对模式。CSC 踏频/速度一体传感器可在绑定后于「显示设置」切换用途。"/>
</LinearLayout>
