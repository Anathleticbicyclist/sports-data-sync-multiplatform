<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bc_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_btnBack"
                android:padding="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ 返回"/>
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="显示设置"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主显大数字"
            android:paddingStart="10dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bc_bg_card"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_primary"
                android:gravity="center"
                android:id="@+id/bc_optSpeed"
                android:background="@drawable/bc_bg_sport_normal"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="速度"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_primary"
                android:gravity="center"
                android:id="@+id/bc_optPower"
                android:background="@drawable/bc_bg_sport_normal"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="3秒功率"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_primary"
                android:gravity="center"
                android:id="@+id/bc_optHr"
                android:background="@drawable/bc_bg_sport_normal"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="心率"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bc_bg_card"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_primary"
                android:gravity="center"
                android:id="@+id/bc_optPace"
                android:background="@drawable/bc_bg_sport_normal"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="配速"
                android:layout_weight="1"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_primary"
                android:gravity="center"
                android:id="@+id/bc_optAlt"
                android:background="@drawable/bc_bg_sport_normal"
                android:padding="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="海拔"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示项（取消勾选即隐藏，自动腾出空间）"
            android:paddingStart="10dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bc_bg_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="骑行计时"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="3秒功率（橙色块）"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="心率"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swHr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="踏频"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swCad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="距离"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="累计爬升"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swAscent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="坡度"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swGrade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="海拔"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="均速"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="最大速度"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <View
                android:background="@color/bc_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/bc_text_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="气压计海拔（系统气压计）"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/bc_swBaro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:paddingTop="4dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="速度计轮周长（米）"
            android:paddingStart="10dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bc_bg_card"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_edtWheel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2.096"
                android:layout_weight="1"
                android:inputType="numberDecimal"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/bc_accent"
                android:id="@+id/bc_btnSaveWheel"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/bc_text_secondary"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="常见轮周长：700×25C=2.096m、700×28C=2.136m、26×1.95=2.050m。仅在速度计生效且 GPS 无速度时使用。"/>
    </LinearLayout>
</ScrollView>
