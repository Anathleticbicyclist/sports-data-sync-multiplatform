<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bc_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_btnBack"
            android:padding="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹ 返回"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:id="@+id/bc_tvSportName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="骑行"
            android:layout_weight="1"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/bc_accent"
            android:id="@+id/bc_tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:fontFamily="monospace"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bc_rowStatus"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvGpsState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="等待定位…"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvBaro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="气压计"
            android:layout_marginEnd="12dp"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvBle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="传感器未连"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/bc_mainCard"
        android:background="@drawable/bc_bg_card"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="@color/bc_speed_color"
                android:id="@+id/bc_tvMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"
                android:fontFamily="monospace"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_gravity="bottom"
                android:id="@+id/bc_tvMainUnit"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvMainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="速度 · 点击切换"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bc_rowTime"
        android:background="@drawable/bc_bg_card"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/bc_text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="骑行计时"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:gravity="end"
            android:id="@+id/bc_tvTimeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:layout_weight="1"
            android:fontFamily="monospace"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bc_blockPower"
            android:background="@color/bc_orange"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/bc_white"
                android:id="@+id/bc_tvPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_cream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3秒功率 W"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bc_blockHr"
            android:background="@drawable/bc_bg_card"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvHr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="心率 bpm"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/bc_blockCad"
            android:background="@drawable/bc_bg_card"
            android:padding="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvCad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:id="@+id/bc_tvCadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="踏频 rpm"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_cardDist"
            android:background="@drawable/bc_bg_card"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="距离"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvDist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_cardAscent"
            android:background="@drawable/bc_bg_card"
            android:padding="10dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="累计爬升"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvAscent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_itemGrade"
            android:background="@drawable/bc_bg_card"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="坡度"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0%"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_itemAlt"
            android:background="@drawable/bc_bg_card"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="海拔"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0m"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_itemAvg"
            android:background="@drawable/bc_bg_card"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:id="@+id/bc_tvAvgLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="均速"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvAvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_itemMax"
            android:background="@drawable/bc_bg_card"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:id="@+id/bc_tvMaxLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="最大"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bc_itemBaro"
            android:background="@drawable/bc_bg_card"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/bc_text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="气压海拔"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/bc_text_primary"
                android:id="@+id/bc_tvBaroAlt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
        </LinearLayout>
    </LinearLayout>
    <com.jichi.bikecomputer.ui.TrackPreviewView
        android:id="@+id/bc_trackView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="16sp"
            android:textColor="@color/bc_white"
            android:id="@+id/bc_btnStart"
            android:background="@drawable/bc_bg_primary_button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="开始"
            android:layout_weight="1"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/bc_white"
            android:id="@+id/bc_btnPause"
            android:background="@drawable/bc_bg_pause_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="暂停"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
        <Button
            android:textSize="16sp"
            android:textColor="@color/bc_white"
            android:id="@+id/bc_btnStop"
            android:background="@drawable/bc_bg_stop_button"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="停止"
            android:layout_weight="1"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
