<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

                <!-- 同步设置 -->
                <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ 同步设置" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="数据来源:" android:textSize="13sp" android:textColor="@color/text_primary" />
                <GridLayout android:id="@+id/gridSource" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" android:rowCount="3">
                <com.google.android.material.button.MaterialButton android:id="@+id/srcIgp" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="iGPSPORT" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="igp" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcXz" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="行者" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="xz" app:backgroundTint="@color/xingzhe_blue" app:cornerRadius="8dp" android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcMg" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="迈金" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="mg" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcBb" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="黑鸟" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="bb" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcBr" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="百锐腾" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="br" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcGm" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="佳明国际" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="gm" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcGcn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="佳明中国" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="gcn" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcCscn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="高驰中国" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="cscn" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcCs" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="高驰国际" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="cs" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/srcWahoo" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="Wahoo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="wo" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                </GridLayout>
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="同步目标 (逆向流动):" android:textSize="13sp" android:textColor="@color/text_primary" />
                <GridLayout android:id="@+id/gridTarget" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4">
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtOb" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnSpan="4" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="Outbase" android:textSize="13sp" android:maxLines="1" android:tag="ob" app:backgroundTint="@color/outbase_orange" app:cornerRadius="8dp" android:textColor="@color/white" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtIgp" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="iGPSPORT" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="igp" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtXz" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="行者" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="xz" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtMg" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="迈金" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="mg" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtBb" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="黑鸟" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="bb" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtBr" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="百锐腾" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="br" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtGm" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="佳明国际" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="gm" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtGcn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="佳明中国" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="gcn" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtCscn" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="高驰中国" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="cscn" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtCs" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="高驰国际" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="cs" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/tgtWahoo" android:layout_width="0dp" android:layout_height="44dp" android:layout_columnWeight="1" android:layout_margin="2dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="Wahoo" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:tag="wo" app:backgroundTint="@color/grey_light" app:cornerRadius="8dp" android:textColor="@color/text_primary" />
                </GridLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="同步数量:" android:textSize="13sp" android:textColor="@color/text_primary" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="1000" android:stepSize="1" android:value="20" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" />
                <TextView android:id="@+id/tvCount" android:layout_width="56dp" android:layout_height="wrap_content" android:text="20" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/primary" android:background="@drawable/input_box_bg" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跳过前N条:" android:textSize="13sp" android:textColor="@color/text_primary" />
                <com.google.android.material.slider.Slider android:id="@+id/sliderSkip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0" android:valueTo="10000" android:stepSize="1" android:value="0" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" />
                <TextView android:id="@+id/tvSkip" android:layout_width="56dp" android:layout_height="wrap_content" android:text="0" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/primary" android:background="@drawable/input_box_bg" android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="2dp" android:paddingEnd="2dp" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                
                <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchGcj02" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="迈金 GCJ-02→WGS84 坐标转换" android:textSize="12sp" />
                
                <TextView android:id="@+id/tvSaveDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="middle" />
                <TextView android:id="@+id/tvSyncedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/green" />
                </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
