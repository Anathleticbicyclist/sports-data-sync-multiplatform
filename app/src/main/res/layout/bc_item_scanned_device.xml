<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bc_text_primary"
            android:ellipsize="end"
            android:id="@+id/bc_tvDevName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="设备名"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvDevType"
            android:background="@drawable/bc_bg_card"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未知设备"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvDevMac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="MAC"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/bc_text_secondary"
            android:id="@+id/bc_tvDevRssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-60 dBm"/>
    </LinearLayout>
</LinearLayout>
