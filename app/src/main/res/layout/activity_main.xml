<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/grey_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="鸡翅幸哲迈进OB(开发体验版)"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Slogan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="🎯 让运动数据自由流动"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- 平台登录区（v6.5.0 两列网格布局） -->
            <GridLayout
                android:id="@+id/gridPlatforms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:columnCount="2">

                <!-- iGPSPORT -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/igp_green" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="iGPSPORT" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvIgpStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnIgpLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录iGPSPORT" android:textSize="11sp" app:backgroundTint="@color/igp_green" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 行者 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/xingzhe_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="行者" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvXingzheStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnXingzheLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录行者" android:textSize="11sp" app:backgroundTint="@color/xingzhe_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 迈金 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/magene_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="迈金" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvMageneStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnMageneLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录迈金" android:textSize="11sp" app:backgroundTint="@color/magene_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 黑鸟单车 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="#2c3e50" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="黑鸟单车" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvBlackbirdStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBlackbirdLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录黑鸟" android:textSize="11sp" app:backgroundTint="#2c3e50" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 百锐腾 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="百锐腾" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvBrytonStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnBrytonLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录百锐腾" android:textSize="11sp" app:backgroundTint="@color/red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outbase -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/outbase_orange" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Outbase" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvOutbaseStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnOutbaseLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录Outbase" android:textSize="11sp" app:backgroundTint="@color/outbase_orange" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 佳明国际 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/garmin_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="佳明国际" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvGarminComStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnGarminComLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录佳明国际" android:textSize="11sp" app:backgroundTint="@color/garmin_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 佳明中国 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/garmin_blue" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="佳明中国" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvGarminCnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnGarminCnLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录佳明中国" android:textSize="11sp" app:backgroundTint="@color/garmin_blue" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 高驰中国 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/coros_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="高驰中国" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvCorosCnStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCorosCnLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录高驰中国" android:textSize="11sp" app:backgroundTint="@color/coros_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 高驰国际 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/coros_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="高驰国际" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvCorosIntStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnCorosIntLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录高驰国际" android:textSize="11sp" app:backgroundTint="@color/coros_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wahoo -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_margin="3dp" android:layout_columnWeight="1"
                    app:cardCornerRadius="10dp" app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <View android:layout_width="4dp" android:layout_height="26dp" android:background="@color/wahoo_red" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Wahoo" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <TextView android:id="@+id/tvWahooStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="❌ 未登录" android:textColor="@color/red" android:textSize="11sp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnWahooLogin" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:text="登录Wahoo" android:textSize="11sp" app:backgroundTint="@color/wahoo_red" app:cornerRadius="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

<!-- 同步设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️ 同步设置" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="数据来源:" android:textSize="13sp" android:textColor="@color/text_primary" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupSource" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iGPSPORT" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="行者" android:checked="true" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="迈金" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="黑鸟" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="百锐腾" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="佳明国际" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="佳明中国" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高驰中国" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高驰国际" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wahoo" style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="同步目标 (逆向流动):" android:textSize="13sp" android:textColor="@color/text_primary" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupTarget" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Outbase" android:tag="ob" android:checked="true" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iGPSPORT" android:tag="igp" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="行者" android:tag="xz" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="迈金" android:tag="mg" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="黑鸟" android:tag="bb" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="百锐腾" android:tag="br" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="佳明国际" android:tag="gm" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="佳明中国" android:tag="gcn" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高驰中国" android:tag="cscn" style="@style/Widget.MaterialComponents.Chip.Choice" />
                        <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高驰国际" android:tag="cs" style="@style/Widget.MaterialComponents.Chip.Choice" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="同步数量:" android:textSize="13sp" android:textColor="@color/text_primary" />
                        <com.google.android.material.slider.Slider android:id="@+id/sliderCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="1" android:valueTo="1000" android:stepSize="1" android:value="20" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" />
                        <TextView android:id="@+id/tvCount" android:layout_width="40dp" android:layout_height="wrap_content" android:text="20" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/primary" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跳过前N条:" android:textSize="13sp" android:textColor="@color/text_primary" />
                        <com.google.android.material.slider.Slider android:id="@+id/sliderSkip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="0" android:valueTo="10000" android:stepSize="1" android:value="0" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" />
                        <TextView android:id="@+id/tvSkip" android:layout_width="40dp" android:layout_height="wrap_content" android:text="0" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/primary" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchGcj02" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="迈金 GCJ-02→WGS84 坐标转换" android:textSize="12sp" />

                    <TextView android:id="@+id/tvSaveDir" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="10sp" android:textColor="@color/text_secondary" android:maxLines="1" android:ellipsize="middle" />
                    <TextView android:id="@+id/tvSyncedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/green" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 自动同步 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchAutoSync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰ 后台自动同步" android:textSize="13sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="检测间隔:" android:textSize="12sp" />
                        <com.google.android.material.slider.Slider android:id="@+id/sliderAutoInterval" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:valueFrom="30" android:valueTo="3600" android:stepSize="30" android:value="300" app:thumbColor="@color/primary" app:trackColorActive="@color/primary" />
                        <TextView android:id="@+id/tvAutoInterval" android:layout_width="50dp" android:layout_height="wrap_content" android:text="5分钟" android:textSize="12sp" android:textStyle="bold" android:gravity="center" android:textColor="@color/primary" />
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="提示: 开启后关闭APP需锁定后台、关闭电池优化" android:textSize="10sp" android:textColor="@color/text_secondary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPowerGuide" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="4dp" android:text="🔋 后台常驻指引 &amp; 电池保护设置" android:textSize="11sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 按钮区 -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSync" android:layout_width="match_parent" android:layout_height="52dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="🚴 开始同步" android:textSize="15sp" app:backgroundTint="@color/primary" app:cornerRadius="10dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:maxLines="1" android:singleLine="true" android:ellipsize="none" android:paddingStart="2dp" android:paddingEnd="2dp" android:gravity="center" android:text="⏹ 停止" android:textSize="12sp" android:enabled="false" app:backgroundTint="@color/red" app:cornerRadius="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTestDownload" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:maxLines="1" android:singleLine="true" android:ellipsize="none" android:paddingStart="2dp" android:paddingEnd="2dp" android:gravity="center" android:text="🧪 测试" android:textSize="12sp" app:backgroundTint="@color/igp_green" app:cornerRadius="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyLog" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:maxLines="1" android:singleLine="true" android:ellipsize="none" android:paddingStart="2dp" android:paddingEnd="2dp" android:gravity="center" android:text="📋 复制" android:textSize="12sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearSync" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:maxLines="1" android:singleLine="true" android:ellipsize="none" android:paddingStart="2dp" android:paddingEnd="2dp" android:gravity="center" android:text="🗑 清记忆" android:textSize="12sp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:cornerRadius="10dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:visibility="gone" app:indicatorColor="@color/primary" app:trackColor="@color/grey_light" />

            <!-- 日志 -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="10dp" app:cardElevation="2dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋 运行日志" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                    <ScrollView android:id="@+id/svLog" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="4dp" android:background="#F0F0F0" android:padding="4dp">
                        <TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="等待操作..." android:textSize="10sp" android:fontFamily="monospace" android:textColor="@color/text_primary" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部信息 -->
            <TextView android:id="@+id/tvClubLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="🏠 鸡翅幸哲迈进OB同步工具开发者俱乐部" android:textColor="@color/primary" android:textSize="11sp" android:padding="2dp" />
            <TextView android:id="@+id/tvUpdateLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="📦 鸡翅幸哲迈进OB(开发体验版)
开发版不稳定且用且珍惜" android:textColor="@color/primary" android:textSize="11sp" android:padding="2dp" />
            <TextView android:id="@+id/tvOfficialLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="🚴 鸡翅幸哲迈进OB正式版
正式版稳定可用，开发版不稳定请下载正式版" android:textColor="@color/primary" android:textSize="11sp" android:padding="2dp" />
            <!-- 鸣谢 -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="🙏 鸣谢" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:padding="2dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢iGPSPORT、迈金、黑鸟单车、百锐腾、行者、Outbase 为运动用户提供的数据记录与存储服务" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢以下人员为软件测试提供的帮助：素甲粉、青岛AUV阿哲、清茶、萧、洪斌大哥、鸽子王腰果、rockozhao、胶州一哥大沽河河长赵铁柱、海参" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" android:layout_marginBottom="4dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="如有问题，欢迎加入俱乐部跟主理人反馈。开发中功能招募测试人员欢迎联系主理人~" android:textColor="@color/text_secondary" android:textSize="10sp" android:padding="2dp" android:layout_marginBottom="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
