<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="logo" />

        <!-- 应用名 + 版本 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="鸡翅幸哲迈进OB"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="开发体验版 v7.7.5"
            android:textColor="@color/green"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="🎯 让运动数据自由流动"
            android:textColor="@color/green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 一句话介绍 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="本项目完全开源免费，如觉得项目对你有帮助，可赞赏支持作者后续功能迭代与问题修复。"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- 更新日志 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋 本次更新 (v7.7.5)" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1. 修复设置记忆功能：同步设置页保留上次设置（来源/目标/同步数量/跳过条数/坐标转换/强制重传）" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="📦 v7.7.4" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1. 新增「捷安特骑行」同步目标：账号密码直接登录，纯API直传，支持同步上传\n2. 登录页百锐腾替换为捷安特（百锐腾下载入口保留，开发中）\n3. 修复捷安特登录后目标不能立即选择：登录成功自动刷新设置页，无需重启App\n4. 修复注销后无法切换账号：彻底清除WebView登录态（高驰等平台），注销后重登可输新账号" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="📦 v7.7.3" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1. 修复iGPSPORT登录页在部分机型WebView加载失败（改用移动UA+兼容性优化）\n2. 修复注销后重新登录沿用旧账号、看不到登录窗口（注销时清除该平台WebView登录态）\n3. 优化佳明登录失败提示（区分风控/限流），登录稳定性优化" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 链接（只保留俱乐部+开发版） -->
        <TextView android:id="@+id/tvClubLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="鸡翅幸哲迈进OB同步工具:开发者俱乐部" android:textColor="@color/text_primary" android:textSize="11sp" android:padding="2dp" />
        <TextView android:id="@+id/tvUpdateLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="➠更新地址鸡翅幸哲迈进OB（开发体验版） 开发版:Github项目" android:textColor="@color/text_primary" android:textSize="11sp" android:padding="2dp" />

        <!-- 鸣谢（与原版一致） -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="🙏 鸣谢" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:padding="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢iGPSPORT、迈金、黑鸟单车、百锐腾、行者、高驰、佳明、Wahoo、Outbase为运动用户提供的数据记录与存储服务" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢以下人员(均为骑行爱称)为软件测试提供的帮助：素甲粉、青岛AUV阿哲、清茶、萧、洪斌大哥、鸽子王腰果、rockozhao、胶州一哥大沽河河长赵铁柱、海参、兰兰大王、。、初夏飞雪bab、心急吃不了热豆付、青山依旧张指导、阿泽阿" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="鸣谢青岛AUV俱乐部" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="如有问题，欢迎加入Outbase俱乐部跟主理人反馈。开发者:多吃两口" android:textColor="@color/text_secondary" android:textSize="10sp" android:padding="2dp" android:layout_marginBottom="8dp" />

        <!-- 赞赏（微信+支付宝并列） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="💰 赞赏支持"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <ImageView android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/reward_wechat" android:contentDescription="微信赞赏码" android:adjustViewBounds="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="微信赞赏码" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <ImageView android:layout_width="130dp" android:layout_height="wrap_content" android:src="@drawable/reward_alipay" android:contentDescription="支付宝收款码" android:adjustViewBounds="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付宝收款码" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="本项目完全开源免费，您的赞赏将支持后续功能迭代与问题修复"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
