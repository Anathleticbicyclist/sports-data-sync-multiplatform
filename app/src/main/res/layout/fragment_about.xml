<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="logo" />

        <!-- 应用名 + 版本 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="鸡翅幸哲迈进OB"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="开发体验版 v7.6.7"
            android:textColor="@color/green"
            android:textSize="13sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="🎯 让运动数据自由流动"
            android:textColor="@color/green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 一句话介绍 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="本项目完全开源免费，如觉得项目对你有帮助，可赞赏支持作者后续功能迭代与问题修复。"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <!-- 更新日志 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋 本次更新 (v7.6.7)" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1. 一对多同步：一个来源平台可同时同步到多个目标平台，每条运动下载一次自动分发上传\n2. 迈金上传改为纯API直传（移除WebView兜底），后台自动同步也支持迈金\n3. 自动同步支持多目标：一次后台检测同时推送多个平台" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="📦 v7.6.6" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="全新UI界面：浅蓝色调，操作更直观；新增1秒开屏动画；优化体验，解决一些bug" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="📦 v7.6.5" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="1. 黑鸟下载改为构建标准FIT文件（替代GPX）：内置距离字段、坐标高精度、平台兼容性好\n2. 解决黑鸟数据距离不准、坐标漂移、被目标服务器拒收等问题\n3. FIT构建失败自动回退GPX，双保险" android:textSize="12sp" android:textColor="@color/text_primary" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 链接（只保留俱乐部+开发版） -->
        <TextView android:id="@+id/tvClubLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="鸡翅幸哲迈进OB同步工具:开发者俱乐部" android:textColor="@color/text_primary" android:textSize="11sp" android:padding="2dp" />
        <TextView android:id="@+id/tvUpdateLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="➠更新地址鸡翅幸哲迈进OB（开发体验版） 开发版:Github项目" android:textColor="@color/text_primary" android:textSize="11sp" android:padding="2dp" />

        <!-- 鸣谢（与原版一致） -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="4dp" android:text="🙏 鸣谢" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:padding="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢iGPSPORT、迈金、黑鸟单车、百锐腾、行者、高驰、佳明、Wahoo、Outbase为运动用户提供的数据记录与存储服务" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="感谢以下人员(均为骑行爱称)为软件测试提供的帮助：素甲粉、青岛AUV阿哲、清茶、萧、洪斌大哥、鸽子王腰果、rockozhao、胶州一哥大沽河河长赵铁柱、海参、兰兰大王、。、初夏飞雪bab、心急吃不了热豆付、青山依旧张指导、阿泽阿" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="鸣谢青岛AUV俱乐部" android:textColor="@color/text_secondary" android:textSize="9sp" android:padding="1dp" android:layout_marginBottom="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="如有问题，欢迎加入Outbase俱乐部跟主理人反馈。开发者:多吃两口" android:textColor="@color/text_secondary" android:textSize="10sp" android:padding="2dp" android:layout_marginBottom="8dp" />

        <!-- 赞赏（微信+支付宝并列） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="💰 赞赏支持"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <ImageView android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/reward_wechat" android:contentDescription="微信赞赏码" android:adjustViewBounds="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="微信赞赏码" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="4dp">
                <ImageView android:layout_width="130dp" android:layout_height="wrap_content" android:src="@drawable/reward_alipay" android:contentDescription="支付宝收款码" android:adjustViewBounds="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支付宝收款码" android:textSize="11sp" android:textColor="@color/text_secondary" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:text="本项目完全开源免费，您的赞赏将支持后续功能迭代与问题修复"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
